@Parorendeportalen.Api_HostAddress = http://localhost:5109

GET {{Parorendeportalen.Api_HostAddress}}/api/auth/login?returnUrl=/api/auth/me

###

GET {{Parorendeportalen.Api_HostAddress}}/api/auth/me
Accept: application/json

###

POST {{Parorendeportalen.Api_HostAddress}}/api/auth/logout

###

GET {{Parorendeportalen.Api_HostAddress}}/api/visits
Accept: application/json

###

GET {{Parorendeportalen.Api_HostAddress}}/api/visits?pageNumber=1&pageSize=5&from=2026-08-01T00:00:00%2B02:00&to=2026-08-31T23:59:59%2B02:00
Accept: application/json

###

GET {{Parorendeportalen.Api_HostAddress}}/api/visits/1
Accept: application/json

###

GET {{Parorendeportalen.Api_HostAddress}}/api/visits/999
Accept: application/json

###

GET {{Parorendeportalen.Api_HostAddress}}/health
Accept: application/json

###

GET {{Parorendeportalen.Api_HostAddress}}/api/carerecipients
Accept: application/json

###

GET {{Parorendeportalen.Api_HostAddress}}/api/carerecipients/1
Accept: application/json

###

GET {{Parorendeportalen.Api_HostAddress}}/api/carerecipients/999
Accept: application/json

###

# The categories the caller may see for one care recipient
GET {{Parorendeportalen.Api_HostAddress}}/api/consents?careRecipientId=1
Accept: application/json

###

# 403 with a problem-details body once the Visits consent for this pair is
# closed (set ValidTo on the row); 404 for a care recipient the caller holds no grant for
GET {{Parorendeportalen.Api_HostAddress}}/api/visits?careRecipientId=1
Accept: application/json

###

# The latest notifications across every care recipient the caller follows,
# plus the unread count. Empty until the fan-out worker has run.
GET {{Parorendeportalen.Api_HostAddress}}/api/notifications
Accept: application/json

###

# 204 for the caller's own row, 404 for anyone else's
POST {{Parorendeportalen.Api_HostAddress}}/api/notifications/1/read

###

POST {{Parorendeportalen.Api_HostAddress}}/api/notifications/read

###

GET {{Parorendeportalen.Api_HostAddress}}/api/notifications/preferences
Accept: application/json

###

# Kinds: Added, Rescheduled, Completed, Cancelled, Missed, Updated. 400 for any other.
PUT {{Parorendeportalen.Api_HostAddress}}/api/notifications/preferences/Completed
Content-Type: application/json

{ "enabled": false }

###

# Every vedtak the care recipient has, in force or not, with the tasks each one
# lists. Its own consent category, so 403 here does not mean 403 on the timeline.
GET {{Parorendeportalen.Api_HostAddress}}/api/vedtak?careRecipientId=1
Accept: application/json

###

GET {{Parorendeportalen.Api_HostAddress}}/api/vedtak/1?careRecipientId=1
Accept: application/json

###

# 404, the same answer as for a vedtak belonging to someone else
GET {{Parorendeportalen.Api_HostAddress}}/api/vedtak/999?careRecipientId=1
Accept: application/json

###

# Today in Norwegian time when date is left out. Needs consent for both Vedtak
# and Visits, since the plan is one read against the other.
GET {{Parorendeportalen.Api_HostAddress}}/api/dayplan?careRecipientId=1
Accept: application/json

###

# A Wednesday, so the fysioterapi vedtak shows an Expected occurrence next to
# the two hjemmesykepleie ones the visit feed settles.
GET {{Parorendeportalen.Api_HostAddress}}/api/dayplan?careRecipientId=1&date=2026-09-09
Accept: application/json

###

# POST, PUT and DELETE below need this token in the X-XSRF-TOKEN header.
# Log in first: the token belongs to the logged-in user.
GET {{Parorendeportalen.Api_HostAddress}}/api/antiforgery/token
Accept: application/json

###

# Add your own appointment. Visibility is Private (only you) or Shared (the
# other next-of-kin too) and must be set. Answers 201 with an ETag.
POST {{Parorendeportalen.Api_HostAddress}}/api/visits
Content-Type: application/json
X-XSRF-TOKEN: {{token}}

{
  "careRecipientId": 1,
  "scheduledAt": "2026-09-20T10:00:00+02:00",
  "title": "Legetime på Ullevål",
  "notes": "Fabian kjører",
  "visibility": "Shared"
}

###

# If-Match is the version from when you read the entry, in quotes.
# Missing If-Match gives 428. If someone changed the entry since, 412.
PUT {{Parorendeportalen.Api_HostAddress}}/api/visits/4?careRecipientId=1
Content-Type: application/json
If-Match: "12345"
X-XSRF-TOKEN: {{token}}

{
  "scheduledAt": "2026-09-20T11:00:00+02:00",
  "title": "Legetime på Ullevål",
  "notes": "Flyttet en time",
  "visibility": "Private"
}

###

# 403: visits from the home care service cannot be changed in the portal.
PUT {{Parorendeportalen.Api_HostAddress}}/api/visits/1?careRecipientId=1
Content-Type: application/json
If-Match: "12345"
X-XSRF-TOKEN: {{token}}

{
  "scheduledAt": "2026-09-20T11:00:00+02:00",
  "title": "Forsøk på å endre kommunens besøk",
  "visibility": "Shared"
}

###

DELETE {{Parorendeportalen.Api_HostAddress}}/api/visits/4?careRecipientId=1
If-Match: "12345"
X-XSRF-TOKEN: {{token}}

###

# Comments on a visit. You see shared comments and your own private ones.
GET {{Parorendeportalen.Api_HostAddress}}/api/visits/1/comments?careRecipientId=1
Accept: application/json

###

POST {{Parorendeportalen.Api_HostAddress}}/api/visits/1/comments?careRecipientId=1
Content-Type: application/json
X-XSRF-TOKEN: {{token}}

{
  "body": "Mor sa hun ikke fikk medisinene i dag.",
  "visibility": "Shared"
}

###

PUT {{Parorendeportalen.Api_HostAddress}}/api/visits/1/comments/1?careRecipientId=1
Content-Type: application/json
If-Match: "12345"
X-XSRF-TOKEN: {{token}}

{
  "body": "Mor sa hun ikke fikk medisinene i dag. Ringte hjemmetjenesten.",
  "visibility": "Shared"
}

###

DELETE {{Parorendeportalen.Api_HostAddress}}/api/visits/1/comments/1?careRecipientId=1
If-Match: "12345"
X-XSRF-TOKEN: {{token}}

###
